# Secrets fuer den Container — Kopie als .env neben docker-compose.yml ablegen (chmod 600).
# ENV hat Vorrang vor config.json (siehe config.py). Alle weiteren Werte
# (Channel-/Role-/Guild-IDs, Wetter-API) kommen aus ./config/config.json.
NICEBOT_TOKEN=DEIN_BOT_TOKEN

# /verknüpfen — Schnittstelle zum Turnier-Backend (turnier-abgemiked).
# TURNIER_SERVICE_TOKEN MUSS identisch mit SERVICE_TOKEN in /root/turnier/.env sein!
TURNIER_API_URL=http://turnier-backend:3130
TURNIER_SERVICE_TOKEN=GLEICHER_WERT_WIE_TURNIER_SERVICE_TOKEN

# Interner Service-Endpoint (Phase 4): GET /internal/members/:id/roles —
# Guild-Rollen + NiceCom-Mitglieds-Check fürs Turnier-Backend.
# KEIN Host-Port-Mapping — nur aus den Docker-Netzen erreichbar.
# Muss zu NICEBOT_API_URL in der Turnier-.env passen (http://nicebot:8130).
SERVICE_API_PORT=8130
