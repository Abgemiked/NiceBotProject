# nicebot-admin — Beispiel-Konfiguration. Echte Werte NICHT committen.

# --- Discord OAuth2 (aus dem Discord Developer Portal der App) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://nicebot.abgemiked.de/api/auth/callback

# --- Session (langer Zufallswert, z.B. `openssl rand -hex 32`) ---
SESSION_SECRET=
# Lokal ohne HTTPS: COOKIE_SECURE=0 setzen
COOKIE_SECURE=1

# --- Bot Service-API (Rollenauflösung) ---
BOT_API_URL=http://nicebot:8130
# Identisch zum TURNIER_SERVICE_TOKEN des Bots
BOT_SERVICE_TOKEN=
GUILD_ID=

# --- RBAC-Rollen (Defaults sind im Code hinterlegt, hier nur bei Abweichung setzen) ---
# FULL_ADMIN_ROLE_IDS=669879940296081420,1130018862990098463
# MOD_ROLE_IDS=1078399961496039515
